{
  "name": "gtrd-site",
  "version": "1.0.0",
  "main": "src/frontend/scripts/main.js",
  "scripts": {
    "ws": "ws -d dist/uncompressed",
    "start": "webpack-dev-server --host 127.0.0.1 --progress --profile --colors",
    "build": "webpack --config webpack.production.config.js --progress --profile --colors --env.build",
    "build-min": "webpack --config webpack.production.config.js --progress --profile --colors --env.build --env.min",
    "test": "jest",
    "watch": "npm test -- --watch",
    "coverage": "npm test -- --coverage",
    "coveralls": "npm run-script coverage && cat ./coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js"
  },
  "dependencies": {
    "be5-react": "git+https://github.com/DevelopmentOnTheEdge/be5-react.git",
    "beanexplorer-react": "git+https://github.com/DevelopmentOnTheEdge/beanexplorer-react.git",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@babel/plugin-external-helpers": "^7.12.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.12.1",
    "@babel/plugin-transform-modules-commonjs": "^7.12.1",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-react": "^7.12.10",
    "@rollup/plugin-babel": "^5.2.2",
    "@rollup/plugin-commonjs": "^16.0.0",
    "@rollup/plugin-image": "^2.0.6",
    "@rollup/plugin-node-resolve": "^10.0.0",
    "@rollup/plugin-replace": "^2.3.4",
    "babel-jest": "^26.6.1",
    "babel-loader": "^8.2.2",
    "babel-polyfill": "^6.26.0",
    "coveralls": "2.13.1",
    "css-loader": "^5.0.0",
    "cssnano": "4.1.7",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.5",
    "file-loader": "^6.2.0",
    "filemanager-webpack-plugin": "^2.0.5",
    "html-webpack-plugin": "^4.5.1",
    "jest": "^26.6.3",
    "json-server": "^0.16.3",
    "local-web-server": "^4.2.1",
    "mini-css-extract-plugin": "1.3.0",
    "optimize-css-assets-webpack-plugin": "^5.0.4",
    "postcss-loader": "^4.1.0",
    "raw-loader": "^4.0.2",
    "react-hot-loader": "^4.13.0",
    "react-test-renderer": "^16.14.0",
    "sass": "^1.32.2",
    "sass-loader": "^10.1.0",
    "style-loader": "^2.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^4.45.0",
    "webpack-bundle-analyzer": "^3.9.0",
    "webpack-cleanup-plugin": "^0.5.1",
    "webpack-cli": "^3.3.12",
    "webpack-dashboard": "^3.2.1",
    "webpack-dev-server": "^3.11.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevelopmentOnTheEdge/testBe5app.git"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|sass|png|jpg)$": "<rootDir>/test/fileTransformer.js"
    },
    "roots": [
      "./test/",
      "./src/scripts"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "shared",
      "./src/scripts"
    ]
  }
}
